<?xml version="1.0" encoding="utf-8"?>
<!-- O SIGAA usa a raiz GlobalSign R46, que só entrou no Android 14. Ela vale aqui apenas para a UNIFEI. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">unifei.edu.br</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_root_r46" />
        </trust-anchors>
    </domain-config>
</network-security-config>
